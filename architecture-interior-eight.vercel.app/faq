    <!-- Scripts -->
    <script src="assets/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/aos.js"></script>
    
    <script>
        // Initialize AOS
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });

        // Navbar background change on scroll
        window.addEventListener('scroll', function() {
            const navbar = document.getElementById('mainNav');
            if (window.scrollY > 50) {
                navbar.classList.add('navbar-scrolled');
            } else {
                navbar.classList.remove('navbar-scrolled');
            }
        });

        // Scroll to top button visibility and functionality
        const scrollBtn = document.getElementById('scrollToTop');
        window.addEventListener('scroll', function() {
            if (window.scrollY > 500) {
                scrollBtn.classList.add('visible');
            } else {
                scrollBtn.classList.remove('visible');
            }
        });
        scrollBtn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Custom FAQ accordion icon toggles (plus/minus) without conflicting with Bootstrap events
        // This replaces default chevron and adds elegant plus/minus animation.
        document.querySelectorAll('.faq-accordion .accordion-button').forEach(button => {
            const iconSpan = button.querySelector('.faq-icon-wrapper i');
            if (!iconSpan) return;
            
            // Initial state: if collapsed by default, show plus. For expanded (show) we set minus.
            const targetCollapse = document.querySelector(button.getAttribute('data-bs-target'));
            if (targetCollapse && targetCollapse.classList.contains('show')) {
                iconSpan.classList.remove('fa-plus');
                iconSpan.classList.add('fa-minus');
            } else {
                iconSpan.classList.remove('fa-minus');
                iconSpan.classList.add('fa-plus');
            }

            // Listen to Bootstrap show/hide events to toggle icon
            if (targetCollapse) {
                targetCollapse.addEventListener('show.bs.collapse', () => {
                    iconSpan.classList.remove('fa-plus');
                    iconSpan.classList.add('fa-minus');
                });
                targetCollapse.addEventListener('hide.bs.collapse', () => {
                    iconSpan.classList.remove('fa-minus');
                    iconSpan.classList.add('fa-plus');
                });
            }
        });

        // Additional: ensures active nav link highlighting (optional)
        const currentLocation = location.pathname;
        const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
        navLinks.forEach(link => {
            if(link.getAttribute('href') === 'faq.html' && currentLocation.includes('faq')) {
                link.classList.add('active');
            } else if(link.getAttribute('href') === 'index.html' && (currentLocation === '/' || currentLocation === 'index.html')) {
                link.classList.add('active');
            }
        });
    </script>
    <!-- Custom main site script (if needed for other interactions) -->
