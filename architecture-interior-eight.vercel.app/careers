    <script>
        /* AOS */
        AOS.init({ duration: 800, once: true, offset: 80 });

        /* Scroll to top */
        const scrollBtn = document.getElementById('scrollToTop');
        window.addEventListener('scroll', () => scrollBtn.classList.toggle('visible', window.scrollY > 400));
        scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

        /* Smooth anchor scroll */
        document.querySelectorAll('a[href^="#"]').forEach(a => {
            a.addEventListener('click', e => {
                const t = document.querySelector(a.getAttribute('href'));
                if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
            });
        });

        /* ---------- Role Filter ---------- */
        document.querySelectorAll('.car-filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.car-filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const dept = btn.dataset.dept;
                const cards = document.querySelectorAll('.car-role-card');
                let visible = 0;
                cards.forEach(c => {
                    const match = dept === 'all' || c.dataset.dept === dept;
                    c.style.display = match ? 'flex' : 'none';
                    if (match) visible++;
                });
                document.getElementById('rolesEmpty').style.display = visible === 0 ? 'block' : 'none';
            });
        });

        /* ---------- Role Drawer ---------- */
        const drawer = document.getElementById('roleDrawer');
        const overlay = document.getElementById('drawerOverlay');

        function openDrawer(card) {
            document.getElementById('drawerDept').textContent = card.dataset.dept.charAt(0).toUpperCase() + card.dataset.dept.slice(1);
            document.getElementById('drawerTitle').textContent = card.dataset.title;
            document.getElementById('drawerDesc').textContent = card.dataset.desc;

            const tags = document.getElementById('drawerTags');
            tags.innerHTML = `
                <span class="car-drawer__tag"><i class="fas fa-map-marker-alt"></i> ${card.dataset.location}</span>
                <span class="car-drawer__tag"><i class="fas fa-clock"></i> ${card.dataset.type}</span>
                <span class="car-drawer__tag"><i class="fas fa-layer-group"></i> ${card.dataset.level}</span>
            `;
            drawer.classList.add('open');
            overlay.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
            drawer.classList.remove('open');
            overlay.classList.remove('open');
            document.body.style.overflow = '';
        }

        document.querySelectorAll('.car-role-card').forEach(card => {
            card.addEventListener('click', () => openDrawer(card));
        });
        document.getElementById('drawerClose').addEventListener('click', closeDrawer);
        overlay.addEventListener('click', closeDrawer);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });

        /* ---------- Life at Luxe Tabs ---------- */
        document.querySelectorAll('.car-life__tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.car-life__tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.car-life__panel').forEach(p => p.classList.remove('active'));
                tab.classList.add('active');
                document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
            });
        });

        /* ---------- Department Chips ---------- */
        document.getElementById('deptChips').addEventListener('click', e => {
            const chip = e.target.closest('.car-dept-chip');
            if (!chip) return;
            document.querySelectorAll('.car-dept-chip').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
        });
    </script>
